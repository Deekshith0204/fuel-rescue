# =========================================================
# FuelRescue Environment Configuration
# =========================================================

# Firebase Project Credentials
# Obtain these from: https://console.firebase.google.com -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps Platform API Key
# Obtain from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Required APIs:
# 1. Maps JavaScript API
# 2. Places API (New or Legacy)
# 3. Geocoding API
# 4. Directions API
VITE_GOOGLE_MAPS_API_KEY=
